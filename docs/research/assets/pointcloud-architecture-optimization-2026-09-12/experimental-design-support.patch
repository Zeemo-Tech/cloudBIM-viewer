+        context.shared_floating_noise[:member_size] = 1
+        captured = []
+
+        def observed(points, segment_ids, confidence, segments):
+            captured.append(segment_ids.copy())
+            self.assertTrue(np.all(segment_ids[member_size:2 * member_size] > 0))
