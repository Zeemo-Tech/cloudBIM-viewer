+    def test_design_excluded_round_component_cannot_supply_multiview_evidence(self):
+        # A hard-vetoed measured rod used to make this remote unobserved pair
+        # eligible for rejection.  It must be absent from the positive-view
+        # population; without independent allowed evidence the reviewer abstains.
+        hard, hard_normals = rod([0, 0, 0], [.05, 0, 0])
+        candidate = np.array([[.30, .004, 0], [.301, .004, 0]])
+        points = np.vstack((hard, candidate))
+        normals = np.vstack((hard_normals, np.tile([0, 1, 0.], (len(candidate), 1))))
+        review = np.r_[np.zeros(len(hard), bool), np.ones(len(candidate), bool)]
+        baseline, _ = multiview_noise_mask(points, normals=normals,
+            steel_scores=np.full(len(points), .65), review_mask=review)
+        removed, report = multiview_noise_mask(points, normals=normals,
+            steel_scores=np.full(len(points), .65), review_mask=review,
+            support_eligible_mask=np.r_[np.zeros(len(hard), bool), np.ones(len(candidate), bool)])
+        self.assertTrue(baseline[-2:].all())
+        self.assertFalse(removed.any())
+        self.assertEqual(report['supportExcludedPointCount'], len(hard))
+        self.assertEqual(report['supportExcludedReviewPointCount'], 0)
+        self.assertEqual(report['skippedReason'], 'no independent observed steel component')
