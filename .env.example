# ==============================================================================
# cloudBIM-viewer 本地 Docker 开发环境
# 启动命令: docker compose up -d --build
# ==============================================================================

# 服务端口映射
DB_PORT=15432
BACKEND_PORT=8090
MESH_SERVICE_PORT=8001
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
# 可选：主应用中的逐步调试入口；开发模式默认使用当前主机的 8766 端口
VITE_POINTCLOUD_WORKBENCH_URL=
# 可选的受管理点云练武场；启用后随 cloudbim-dev.sh 启停并在崩溃后自动重启
POINTCLOUD_WORKBENCH_ENABLED=false
POINTCLOUD_WORKBENCH_HOST=0.0.0.0
POINTCLOUD_WORKBENCH_PORT=8766
POINTCLOUD_WORKBENCH_ALLOW_HOST=10.0.0.4
POINTCLOUD_WORKBENCH_SOURCE=backend/data/assets/95b6b41c5857d9eb3407b155/source.las
POINTCLOUD_WORKBENCH_OUTPUT=backend/data/assets/95b6b41c5857d9eb3407b155/pointcloud-steps
POINTCLOUD_WORKBENCH_PRIOR_CONFIG=.cloudbim/design-prior/config.json
POINTCLOUD_WORKBENCH_WORKERS=16
POINTCLOUD_WORKBENCH_THROUGH_STEP=6
# 关闭 C2M 降采样时允许的最大原始点数，防止内存峰值杀死 mesh-service
C2M_MAX_UNDOWNSAMPLED_POINTS=5000000
# 分类去噪共享内存缓存上限（MiB）；运行时还会按可用内存缩小，0 表示磁盘回退
REBAR_MEMORY_CACHE_MB=4096
# 空间块并行上限（1–4）；运行时按可用内存与 cgroup CPU/内存约束缩小，1 为串行
REBAR_SPATIAL_WORKERS=4

# PostgreSQL 数据库配置
DB_NAME=cloudbim
DB_USER=postgres
DB_PASSWORD=AuS4tpYfwNSu
DB_NAME=cloudbim

# Backend and converter settings
JWT_SECRET=cloudbim-local-development-secret-change-me
JWT_EXPIRES_IN=720h
REGISTER_CODE=laochen
CLOUDBIM_SEED_DEMO=true
# Use ./backend/data to reuse legacy host-side assets without copying them.
CLOUDBIM_DATA_MOUNT=cloudbim-data
CLOUDBIM_GOCESIUMTILER_DIR=/Users/monica/Desktop/zhongjian-back/tools/gocesiumtiler
CLOUDBIM_IFC_BUNDLE_DIR=/Users/monica/Desktop/zhongjian-back/tools/ifc_bundle
