# ==============================================================================
# cloudBIM-viewer 依赖服务环境配置 (Docker Compose)
# 启动命令: docker compose up -d
# ==============================================================================

# 服务端口映射
DB_PORT=5432
MESH_SERVICE_PORT=8001
# 关闭 C2M 降采样时允许的最大原始点数，防止内存峰值杀死 mesh-service
C2M_MAX_UNDOWNSAMPLED_POINTS=5000000

# PostgreSQL 数据库配置
DB_NAME=cloudbim
DB_USER=cloudbim
DB_PASSWORD=cloudbim123456
