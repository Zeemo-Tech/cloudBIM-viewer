{
  "name": "@cloudbim/viewer-core",
  "version": "0.3.0",
  "description": "CloudBIM 查看器内核：Three.js 场景、点云与模型渲染、测量工具、后端 API 客户端与设计令牌。",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "src/styles",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./styles/variables.scss": "./src/styles/variables.scss",
    "./styles/workspace-controls.scss": "./src/styles/workspace-controls.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "vite build"
  },
  "dependencies": {
    "axios": "^1.13.6"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "3d-tiles-renderer": "^0.4.19",
    "element-plus": "^2.11.4",
    "three": "^0.173.0",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@types/three": "^0.183.1"
  }
}
