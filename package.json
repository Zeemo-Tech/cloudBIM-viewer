{
  "name": "cloudbim-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:packages",
    "build": "npm run build:packages && vue-tsc --noEmit && vite build",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:packages": "npm run build -w @cloudbim/viewer-core && npm run build -w @cloudbim/denoise && npm run build -w @cloudbim/bim-preview && npm run build -w @cloudbim/pointcloud-preview && npm run build -w @cloudbim/split-preview && npm run build -w @cloudbim/alignment",
    "pack:packages": "node scripts/pack-packages.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "3d-tiles-renderer": "^0.4.19",
    "axios": "^1.13.6",
    "element-plus": "^2.11.4",
    "spark-md5": "^3.0.2",
    "three": "^0.173.0",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.1.0",
    "vue-tsc": "^3.2.5"
  }
}
