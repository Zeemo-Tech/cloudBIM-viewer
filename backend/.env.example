APP_ENV=developmentn
ADDR=:8090
CLOUDBIM_DATA_DIR=./data
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=720h
REGISTER_CODE=laochen
CLOUDBIM_SEED_DEMO=true

# 可选 postgres 或 mysql。Workbench 对应 mysql。
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=cloudbim
DB_SSLMODE=disable

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROCESSING_WORKERS=2
UPLOAD_CHUNK_LIMIT=67108864
UPLOAD_FILE_LIMIT=107374182400
IFC_BUNDLE_BIN=
GOCESIUMTILER_BIN=
MESH_SERVICE_URL=
