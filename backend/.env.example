# ==============================================================================
# cloudBIM-viewer 后端本地运行配置 (go run .)
# 依赖服务通过 docker compose up postgres mesh-service -d 启动
# ==============================================================================

APP_ENV=development
ADDR=:8090
CLOUDBIM_DATA_DIR=./data

# JWT 鉴权配置
JWT_SECRET=cloudbim-super-secret-jwt-token-key-min-32-chars
JWT_EXPIRES_IN=720h
REGISTER_CODE=laochen
CLOUDBIM_SEED_DEMO=true

# 数据库连接 (对应 docker-compose 启动的 postgres)
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cloudbim
DB_PASSWORD=cloudbim123456
DB_NAME=cloudbim
DB_SSLMODE=disable

# 跨域配置
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 并发 Worker 与上传限制
PROCESSING_WORKERS=2
UPLOAD_CHUNK_LIMIT=67108864
UPLOAD_FILE_LIMIT=107374182400

# 算法微服务 (对应 docker-compose 启动的 mesh-service)
MESH_SERVICE_URL=http://127.0.0.1:8001

# 转换工具路径 (如果留空，后端会自动从 ../tools/ 下自动查找)
IFC_BUNDLE_BIN=
GOCESIUMTILER_BIN=
